{
  "info": {
    "_postman_id": "career-guidance-agent-collection",
    "name": "Career Guidance Agent API",
    "description": "Complete API collection for the Career Guidance Agent. Set {{base_url}} to http://localhost:8000 and {{token}} to your JWT after login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "token",    "value": "",                     "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password1\",\n  \"education\": \"B.Tech Computer Science\",\n  \"experience\": 2\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"education\": \"M.Tech AI\",\n  \"experience\": 3,\n  \"skills\": [\"Python\", \"React\", \"ML\"],\n  \"bio\": \"Passionate developer and AI enthusiast.\"\n}"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/profile/password",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Password1\",\n  \"new_password\": \"NewPassword2\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Generate Recommendation",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/recommend",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"education\": \"B.Tech Computer Science\",\n  \"college\": \"MIT\",\n  \"cgpa\": 8.5,\n  \"years_of_experience\": 2,\n  \"skills\": [\"Python\", \"Machine Learning\", \"SQL\", \"React\"],\n  \"interests\": [\"Artificial Intelligence\", \"Data Science\", \"Web Development\"],\n  \"career_goal\": \"Become a Senior ML Engineer at a top tech company within 3 years\",\n  \"preferred_industry\": \"Technology\",\n  \"preferred_location\": \"San Francisco, CA\",\n  \"expected_salary\": \"$120,000 - $150,000 per year\"\n}"
            }
          }
        },
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/history?page=1&limit=10",
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "10" },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Delete Recommendation",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/history/:id",
            "url_variables": [{ "key": "id", "value": "your-recommendation-id-here" }],
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
